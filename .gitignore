# Pulse-probe dump from the visual editor's webview (workspace-local, transient)
# Anchored on purpose: the repo root is the ONLY place a probe dir belongs (see
# src/extension/repo-root.ts). One written anywhere else is a bug,
# and leaving it unignored is what surfaces it — it shows up as an untracked
# dir and blocks scripts/new-task.sh instead of sitting there unnoticed.
/.probe/

# Prebuilt Go binary cache (built once by the editor runner; not for VCS)
/.wirefold-cache/

# Scene sidecar — gitignored so camera/label state does not generate commit noise.
# Diagram state (positions, fades) stays in topology.json.
/topology.scene.json

# Tree-topology scene sidecar (auto-written by Go on each run; not for VCS).
/topology/view/scene.json
/topology/view/scene.json.tmp

# One-file-per-writer split of the scene sidecar above: each of these has exactly ONE
# writer, which is what let sceneFileMu be deleted rather than narrowed. camera/overlays/
# sphere are the same kind of auto-written, locally-preferred view state scene.json was —
# not for VCS.
# nodes/<id>/local-polars.json is NOT listed here: it carries the same authoritative
# per-node data base.json does (which IS tracked), so it stays trackable too. A node's
# position itself lives in base.json (base) plus nodes/<id>/drag/position.json (delta,
# gitignored above), not a separate position.json.
/topology/view/camera/
/topology/view/sphere/

# One flag, one file: the overlays and panels dirs hold a bool per flag, same locally-
# preferred view state the single files were.
/topology/view/overlays/
/topology/view/panels/

# The same state, now one block file per concern instead of a directory of
# one-value files. The dirs above stay listed so an older scene tree is still
# ignored while its leftovers sit there.
/topology/view/overlays.bin
/topology/view/panels.bin
/topology/view/camera.bin
/topology-pair/view/overlays.bin
/topology-pair/view/panels.bin
/topology-pair/view/camera.bin

# One value, one file, for chrome Go draws rather than streams: each piece writes
# its layout here every time it changes. It is DERIVED - Go recomputes the whole
# piece from the model each frame - so it is the same not-for-VCS kind as the dirs
# above, not saved state.
/topology/view/chrome/
/topology-pair/view/chrome/

# The current input the gesture goroutine reads. It is the live pointer, not
# saved state — committing it would commit where a mouse was.
/topology/view/input/
/topology-pair/view/input/

# The per-tick scene, now that the content buffer's blocks cross as files: one
# block file per owner under nodes/<row>/ and edges/<row>/, plus the singletons
# beside them. Go rewrites every one of these from the model on the tick that
# changes it, so they are DERIVED — the same not-for-VCS kind as chrome/ above,
# and committing them would commit a moment mid-animation.
/topology/view/nodes/
/topology/view/edges/
/topology-pair/view/nodes/
/topology-pair/view/edges/
/topology/view/owner-counts.bin
/topology/view/pointer-target.bin
/topology/view/ring-points.bin
/topology/view/slider-panel.bin
/topology/view/speed.bin
/topology-pair/view/owner-counts.bin
/topology-pair/view/pointer-target.bin
/topology-pair/view/ring-points.bin
/topology-pair/view/slider-panel.bin
/topology-pair/view/speed.bin

# Hook block log (local audit trail, not for VCS)
.claude/hooks/go-blocks.log

# Editor settings
.vscode/*
# These four are shared, not personal: launch.json is the only way into the Extension
# Development Host, tasks.json is the build it runs, settings.json carries the watcher
# excludes the probe logs need, and the guard checks the first of them still works. They
# were tracked before the ignore above existed, which made them survive by accident; named
# here so a new one does not silently go missing instead.
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/settings.json
!.vscode/check-launch-config.sh

# macOS
.DS_Store

.claude/scheduled_tasks.lock

# Agent worktrees (temporary, per-agent scratch checkouts)
.claude/worktrees/

# Python bytecode from the delegation hooks (scripts/*.py).
__pycache__/
*.pyc

# LIVE SCENE STATE, written continuously by the running sim — untracked on purpose.
#
# view/*.json (camera pose, overlay flags, scene sphere, selected tab) is written by the
# view-owner goroutine and is rewritten while you orbit or toggle anything, so it stays
# .gitignore'd the ordinary way.
#
# A node's own position and each of its outgoing edges' geometry delta live under a
# gitignored drag/ directory (drag/index-*.json, drag/edges/<label>.json) as an ACCUMULATED
# DELTA composed onto the tracked base.json/<label>.json seed. skip-worktree (the previous
# mechanism, `src/Node/Wiring/gitskip`) is gone: it only suppressed status/diff reporting, so
# `git checkout` still refused to switch branches when a marked file differed from the
# index, forcing drag output into a commit. A plain gitignored subdirectory has no such
# failure mode.
topology*/view/*.json
topology*/nodes/*/drag/

# Whether a node's drag rule is currently ACTIVE is persisted output, deliberately separate
# from the rule's VALUES (drag.phi/drag.maxTheta), which stay in the tracked base.json seed.
# One flag per file under rule-active/, including one per edge under rule-active/edges/.
topology*/nodes/*/rule-active/

# Trace events. Go appends one fixed-width binary record per event to the file
# belonging to the item the event is ABOUT, beside that item's other blocks:
# view/nodes/<row>/trace.bin, view/edges/<row>/trace.bin, and the interior- and
# beads- variants. They are diagnostics, not scene state, and they grow without
# bound while the editor runs — so they sit with their item for reading, and out
# of the commit. Everything else under view/ IS the scene and stays tracked.
topology*/view/**/trace.bin
topology*/view/**/*-trace.bin
topology*/view/trace.bin

# Where the running extension listens for "open this file as a tab", and that
# session's token. Written on activation, removed on shutdown.
docs/pair-node/port.js
